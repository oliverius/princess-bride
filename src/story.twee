:: StoryStylesheet [stylesheet]
html,
body {
	background: #000000;
	color: #f4f1e9;
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	font-size: 1.0625rem;
	line-height: 1.7;
	margin: 0;
	min-height: 100%;
}

body {
	padding: 0;
}

html {
	scrollbar-gutter: stable;
}

#ui-bar,
#ui-bar-toggle {
	display: none !important;
}

#story {
	box-sizing: border-box;
	margin: 0 auto;
	margin-left: auto !important;
	margin-right: auto !important;
	max-width: 640px;
	padding: clamp(1.5rem, 6vw, 3.5rem) 1.25rem 4rem;
	width: 100%;
}

#passages {
	margin: 0;
}

#passages br {
	display: none;
}

.scene-illustration {
	aspect-ratio: 16 / 9;
	background: #101010;
	margin: 0 0 24px;
	overflow: hidden;
	width: 100%;
}

.scene-illustration img {
	display: block;
	height: 100%;
	object-fit: cover;
	width: 100%;
}

#passages p {
	margin: 0;
}

#passages p:not(.narration):not(.dialogue):not(.continue) {
	margin-top: 16px;
}

#passages p.narration {
	margin-bottom: 16px;
}

#passages p.narration + br + p.dialogue {
	margin-top: 20px;
}

#passages p.dialogue {
	margin: 0 0 12px;
}

#passages p.dialogue + br + p.narration {
	margin-top: 16px;
}

#passages p.continue {
	margin-top: 1.8rem;
}

.speaker {
	font-weight: 650;
}

.framing-dialogue {
	color: #8d7135;
	font-style: italic;
}

.choices {
	list-style: none;
	margin: 1.6rem 0 0;
	padding: 0;
}

.choices li {
	margin: 0.65rem 0;
}

.choices a {
	color: #ecd28f;
	cursor: pointer;
	text-decoration: none;
}

.choices a::before {
	content: "› ";
	opacity: 0;
	transition: opacity 140ms ease;
}

.choices a:hover,
.choices a:focus-visible {
	color: #fff0bd;
}

.choices a:hover::before,
.choices a:focus-visible::before {
	opacity: 1;
}

a:focus-visible {
	outline: 2px solid #ecd28f;
	outline-offset: 4px;
}

.continue {
	margin-top: 1.8rem;
}

.continue a {
	color: #ecd28f;
	text-decoration: none;
}

.continue a:hover,
.continue a:focus-visible {
	color: #fff0bd;
	text-decoration: underline;
	text-underline-offset: 0.2em;
}

@media (max-width: 420px) {
	body {
		font-size: 1rem;
	}

	#story {
		padding-left: 1rem;
		padding-right: 1rem;
	}

}

@media (prefers-reduced-motion: reduce) {
	* {
		scroll-behavior: auto !important;
		transition-duration: 0.01ms !important;
	}
}

